<div id="gr-root" data-cluster-id="{{clusterId}}" data-cluster-name="{{clusterName}}" data-version="{{version}}" data-load-mode="{{loadMode}}">
  <div class="gr-head">
    <h3>GFS2 Storage</h3>
    <span class="gr-muted">GFS2 Rescue {{version}}</span>
    <span class="gr-muted" id="gr-status">Not loaded</span>
    <span style="flex:1"></span>
    <span id="gr-auto-wrap" hidden><label class="gr-auto" for="gr-auto"><input type="checkbox" id="gr-auto"> Don't auto-load this tab</label></span>
    <button type="button" class="gr-btn" id="gr-rescan-storage" title="SCSI/iSCSI rescan on every host, for a LUN just exported" hidden>Rescan storage</button>
    <button type="button" class="gr-btn gr-primary" id="gr-refresh" title="Ask every host of this cluster what it sees, now" hidden>Scan now</button>
  </div>
  <div class="gr-clusterbox">
    <div><span class="gr-k">Morpheus cluster</span> <span class="gr-v">{{clusterName}}</span></div>
    <div><span class="gr-k">DLM cluster name</span> <span class="gr-v" id="gr-dlm">-</span></div>
    <div><span class="gr-k">Hosts in this cluster</span> <span class="gr-v" id="gr-hostcount">-</span></div>
    <div><span class="gr-k">API credential (Attach)</span> <span class="gr-v" id="gr-cred">-</span></div>
  </div>
  <div id="gr-body"></div>
</div>
<script nonce="{{nonce}}">
  /* Static shell (0.1.25): no styles, no data, no request. The page watcher from the plugin's
     global component loads everything the first time this tab is visible. Tab scripts are
     usually stripped; where they run, this only nudges the watcher. */
  if (window.grShellFind) window.grShellFind();
</script>
